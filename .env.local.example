# Copy to .env.local and fill in. Never commit .env.local.
# Used by compose.local.yaml (make local-up). Local only: never use these values on the VPS.

# --- Postgres (container on Mac port 5433) -----------------------------------
POSTGRES_USER=jbh_admin
POSTGRES_PASSWORD=change-me

# Password of the Postgres role jbh_monitor, which Alloy uses. It sits inside a URL, so use a
# URL-safe value: openssl rand -hex 24. initdb/ reads it on the first start of an empty volume;
# make local-pg-monitor reads it for an existing Postgres.
JBH_PG_MONITOR_PASSWORD=change-me
# Optional. Alloy builds its Postgres connection string from the password above, for the Docker jbh-postgres.
# Set this only to reach another Postgres, for example one installed on the Mac (see LOCAL.md):
# JBH_PG_MONITOR_DSN=postgresql://jbh_monitor:<password>@host.docker.internal:5432/postgres?sslmode=disable

# --- Auth --------------------------------------------------------------------
# HMAC secret. IAM signs tokens with it, the gateway checks them. One value for both.
# A service you run from the IDE must use the same value, or every call gets a 401.
# Generate: openssl rand -base64 32
JBH_JWT_SECRET=change-me
# Google OAuth client IDs, comma separated. Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=

# --- Email (jbh-notification) ------------------------------
# Empty is fine locally: invitation emails then fail, the rest works.
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=465
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# --- AI (jbh-personal-finance bank statement import) -------------------------
# Empty keys keep the service up. Only the import endpoint answers with an error.
STATEMENT_TEXT_SOURCE=pdfbox
STATEMENT_LLM=openrouter
AZURE_DI_ENDPOINT=
AZURE_DI_API_KEY=
AZURE_DI_PAGES_PER_REQUEST=2
OPENROUTER_API_KEY=
GEMINI_API_KEY=
JEV_API_KEY=
OLLAMA_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# How long an import can stay in progress before it counts as stuck.
STATEMENT_IMPORT_STALE_AFTER=10m
STATEMENT_LLM_COMPARE=false
STATEMENT_LLM_COMPARE_DIR=target/llm-compare

# --- Tuning (optional) -------------------------------------------------------
# The values below are the service defaults. Never leave one empty: the service may not start.
# jbh-iam: access token 15 min, refresh token 30 days (in ms), and the user cache.
JWT_EXPIRATION_IN_MS=900000
REFRESH_TOKEN_EXPIRATION_IN_MS=2592000000
CACHE_USER_ENABLED=true
CACHE_USER_MAX_SIZE=5000
CACHE_USER_EXPIRE_ACCESS_MINUTES=30
CACHE_USER_EXPIRE_WRITE_MINUTES=60
# Tracing. 1.0 keeps every trace. The sampler is read by jbh-personal-finance and jbh-notification.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Version label on traces and logs (not read by jbh-notification).
JBH_SERVICE_VERSION=unknown
