# Secrets for the LOCAL cluster. Copy this file to .env.k8s (git-ignored) and fill it:
#   cp k8s/overlays/local/.env.k8s.example k8s/overlays/local/.env.k8s
# KEY=value, one per line, no quotes. Kustomize turns it into the Secret "jbh-secrets".
# This is a new, separate local database: any password works. Never put production values here.

# Postgres admin password. Postgres, jbh-iam (JBH_ADMIN_PASS) and the Quarkus services (DATABASE_PASSWORD) use it.
POSTGRES_PASSWORD=change-me-local

# The JWT signing key: Base64 of at least 32 bytes. jbh-iam signs tokens with it, jbh-gateway checks them.
# Make one with: openssl rand -base64 32
JBH_JWT_SECRET=change-me-run-openssl-rand-base64-32

# Email (jbh-notification). All three need a value, or the service stops at start ("Failed to load config value").
# Placeholders let it start; only sending an email then fails. Use a real Gmail app password to send invitations.
GMAIL_USERNAME=local@example.com
GMAIL_FROM=local@example.com
GMAIL_APP_PASSWORD=change-me

# Bank statement import (jbh-personal-finance). Empty = that provider is off.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
JEV_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_API_KEY=
OLLAMA_API_KEY=
