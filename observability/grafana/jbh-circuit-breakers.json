{
  "title": "JBH - Gateway client circuit breakers",
  "uid": "jbh-circuit-breakers",
  "description": "Circuit breakers of jbh-gateway-client in jbh-personal-finance and jbh-iam. Metrics: resilience4j_circuitbreaker_*. Rules: jbh-gateway-client/README.md, 'Circuit breaker'.",
  "tags": ["jbh", "resilience4j", "circuit-breaker"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(resilience4j_circuitbreaker_state, env)", "refId": "env" },
        "definition": "label_values(resilience4j_circuitbreaker_state, env)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" },
        "allValue": ".*",
        "hide": 0
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(resilience4j_circuitbreaker_state{env=~\"$env\"}, service)", "refId": "service" },
        "definition": "label_values(resilience4j_circuitbreaker_state{env=~\"$env\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "allValue": ".*",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open breakers",
      "description": "Breakers open on at least one instance.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (service, name) (resilience4j_circuitbreaker_state{state=\"open\", env=~\"$env\", service=~\"$service\"}) == 1) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rejected calls (range)",
      "description": "Calls not sent because a breaker was open, in the selected time range.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(resilience4j_circuitbreaker_not_permitted_calls_total{env=~\"$env\", service=~\"$service\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed calls (range)",
      "description": "Calls the breaker counted as failures: no HTTP response, or 502/503/504.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(resilience4j_circuitbreaker_calls_seconds_count{kind=\"failed\", env=~\"$env\", service=~\"$service\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Breakers",
      "description": "Breakers that publish metrics. One per caller and domain, for example JBH_FINANCE_API.User.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (service, name) (resilience4j_circuitbreaker_state{env=~\"$env\", service=~\"$service\"})) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "State (worst instance)",
      "description": "0 closed, 1 half-open, 2 open. If one instance is open, the row shows open.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service, name) (2 * resilience4j_circuitbreaker_state{state=\"open\", env=~\"$env\", service=~\"$service\"} or resilience4j_circuitbreaker_state{state=\"half_open\", env=~\"$env\", service=~\"$service\"} or 0 * resilience4j_circuitbreaker_state{state=\"closed\", env=~\"$env\", service=~\"$service\"})",
          "legendFormat": "{{service}} / {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Closed", "color": "green", "index": 0 },
                "1": { "text": "Half-open", "color": "yellow", "index": 1 },
                "2": { "text": "Open", "color": "red", "index": 2 }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": { "showLegend": false }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failure rate",
      "description": "Failed calls in the sliding window, in %. The breaker opens at 50%. No line until 10 calls were made (the value is -1).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service, name) (resilience4j_circuitbreaker_failure_rate{env=~\"$env\", service=~\"$service\"}) >= 0",
          "legendFormat": "{{service}} / {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Calls per second by result",
      "description": "successful, failed (counts toward opening), ignored (interrupts), not permitted (rejected while open).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, name, kind) (rate(resilience4j_circuitbreaker_calls_seconds_count{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{name}} {{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service, name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{name}} not permitted"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*not permitted" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Average call duration",
      "description": "One call includes all its retries. Compare with the client request timeout (30 s).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, name) (rate(resilience4j_circuitbreaker_calls_seconds_sum{env=~\"$env\", service=~\"$service\"}[$__rate_interval])) / sum by (service, name) (rate(resilience4j_circuitbreaker_calls_seconds_count{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} / {{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
