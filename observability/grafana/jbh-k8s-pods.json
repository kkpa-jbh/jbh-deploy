{
  "title": "JBH Kubernetes pods",
  "uid": "jbh-k8s-pods",
  "description": "Pods of the namespace jbh in a Kubernetes cluster: memory against the limit, CPU, OOM kills, network, and the stdout logs. Metrics from cAdvisor (job kubernetes-cadvisor), logs from loki.source.kubernetes (log_source=kubernetes-stdout). Empty outside Kubernetes.",
  "tags": [
    "jbh",
    "kubernetes"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{namespace=\"jbh\", container!=\"\", container!=\"POD\"}, pod)",
          "refId": "pod"
        },
        "definition": "label_values(container_memory_working_set_bytes{namespace=\"jbh\", container!=\"\", container!=\"POD\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory working set vs limit",
      "description": "Memory each container uses (working set: what the kernel counts for an OOM kill), and its limit as a dashed line of the same pod. Normal: well below the limit. Close to the limit: the next spike kills the container (OOMKilled).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"jbh\", pod=~\"$pod\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (container_spec_memory_limit_bytes{namespace=\"jbh\", pod=~\"$pod\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}} limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU per pod",
      "description": "CPU cores each pod uses (rate over 5 minutes). JBH pods have no CPU limit, so a high value only means the node is busy. A JVM uses a lot at start.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"jbh\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "OOM kills",
      "description": "Containers killed because they used more memory than their limit, per 5 minutes. Normal: 0. More than 0: raise the memory limit or find the leak (jbh-service dashboard, JVM heap).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(container_oom_events_total{namespace=\"jbh\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network in and out",
      "description": "Bytes per second each pod receives and sends (rate over 5 minutes). Pod network is counted on the pod, not the container.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"jbh\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}} in"
        },
        {
          "refId": "B",
          "expr": "-sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"jbh\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Pod stdout logs",
      "description": "What the containers write to stdout and stderr, read through the Kubernetes API. Shows crashes before the OTel SDK starts, and the logs of jbh-web and Postgres. The Java services also send their logs over OTLP: those lines have no k8s_pod_name label.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s_namespace_name=\"jbh\", k8s_pod_name=~\"$pod\"} | log_source=\"kubernetes-stdout\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    }
  ]
}
