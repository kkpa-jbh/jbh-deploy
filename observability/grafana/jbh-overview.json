{
  "title": "JBH - Overview",
  "uid": "jbh-overview",
  "description": "Health of the four JBH backend services: up, request rate, 5xx and 4xx share, p95 latency, plus frontend errors. Metrics: up, http_server_requests_seconds_*.",
  "tags": [
    "jbh",
    "overview"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "JBH dashboards",
      "tags": [
        "jbh"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "tooltip": "All dashboards with the tag jbh"
    },
    {
      "type": "link",
      "title": "Tempo Explore",
      "url": "/explore?orgId=1&left=%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%7D%5D%7D",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Open Explore on the data source with uid tempo (local LGTM). In Grafana Cloud, pick the Tempo data source in Explore."
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up, env)",
          "refId": "env"
        },
        "definition": "label_values(up, env)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "description": "Is the scrape of each service working? 1 = UP, 0 = DOWN. Normal: all four services show UP.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"jbh-(gateway|iam|personal-finance|notification)\", env=~\"$env\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Frontend errors (1h)",
      "description": "Faro exceptions from the browser app (jbh-web) in the last hour, read from Loki. Normal: 0. Needs Alloy with the Faro service.name step; old lines show unknown_service.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"jbh-web\"} |= \"kind=exception\" [1h])) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "text",
      "title": "Frontend",
      "description": "Where the browser signals are.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Frontend (jbh-web)**\n\nLocally: Explore, Loki, `{service_name=\"jbh-web\"}`.\n\nProduction: Grafana Cloud [Frontend Observability](https://grafana.com/docs/grafana-cloud/monitor-applications/frontend-observability/)."
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second per service. Actuator and /q/ calls are left out. Normal: follows the use of the app; a flat 0 while users work is a problem.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"jbh-(gateway|iam|personal-finance|notification)\", env=~\"$env\", uri!~\"/actuator.*|/q/.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "95% of requests are faster than this value. Notification has no bucket series yet, so it shows no line. Normal: below 1 s; the alert fires above 2 s.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"jbh-(gateway|iam|personal-finance|notification)\", env=~\"$env\", uri!~\"/actuator.*|/q/.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "5xx rate (% of requests)",
      "description": "Share of requests that end with a server error (status 5xx). Normal: 0 or very small; the alert fires above 5%.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"jbh-(gateway|iam|personal-finance|notification)\", env=~\"$env\", uri!~\"/actuator.*|/q/.*\", status=~\"5..\"}[$__rate_interval])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"jbh-(gateway|iam|personal-finance|notification)\", env=~\"$env\", uri!~\"/actuator.*|/q/.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "4xx rate (% of requests)",
      "description": "Share of requests that end with a client error (status 4xx): wrong password, no token, not found. Normal: a few percent; a jump can mean a broken client or a token problem.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"jbh-(gateway|iam|personal-finance|notification)\", env=~\"$env\", uri!~\"/actuator.*|/q/.*\", status=~\"4..\"}[$__rate_interval])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"jbh-(gateway|iam|personal-finance|notification)\", env=~\"$env\", uri!~\"/actuator.*|/q/.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
