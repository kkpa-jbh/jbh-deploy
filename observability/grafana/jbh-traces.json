{
  "title": "JBH - Traces",
  "uid": "jbh-traces",
  "description": "Tempo trace views for JBH: slowest, errors, traces over 3 services, service graph. Service names in Tempo: jbh-web, jbh-gateway, jbh-iam-service, jbh-personal-finance.",
  "tags": [
    "jbh",
    "traces"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Slowest traces (gateway, over 500 ms)",
      "description": "Traces that start at jbh-gateway and take longer than 500 ms. Normal: a few slow calls (imports, first call after start). Click a trace id to open the waterfall.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ trace:rootService = \"jbh-gateway\" && trace:duration > 500ms }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Traces with errors",
      "description": "Traces with at least one span with status error. Normal: empty, or only the failures you caused on purpose.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Traces that touch 3 or more services",
      "description": "Explicit form: the same trace has spans of jbh-gateway, jbh-iam-service and jbh-personal-finance. Not count_distinct: the Tempo in grafana/otel-lgtm 0.12.0 answers it with a parse error. For a trace that starts in the browser use { resource.service.name = \"jbh-web\" } && { resource.service.name = \"jbh-gateway\" } && { resource.service.name = \"jbh-iam-service\" }.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"jbh-gateway\" } && { resource.service.name = \"jbh-iam-service\" } && { resource.service.name = \"jbh-personal-finance\" }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "type": "nodeGraph",
      "title": "Service graph",
      "description": "Which service calls which. Built by Tempo from spans, it reads the service graph metrics in Prometheus. Normal: jbh-gateway calls jbh-iam-service and jbh-personal-finance; red edges mean failed calls.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "serviceMap"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Calls per second by client and server",
      "description": "Request rate of each client to server pair, from traces_service_graph_request_total. Normal: follows the traffic.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total[$__rate_interval]))",
          "legendFormat": "{{client}} -> {{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed calls per second by client and server",
      "description": "Failed calls of each pair, from traces_service_graph_request_failed_total. Normal: no line (no series until a call fails).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total[$__rate_interval]))",
          "legendFormat": "{{client}} -> {{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
