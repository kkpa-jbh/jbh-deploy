# Copy to .env on the VPS and fill in. Never commit .env.
# Values that must match between services are set once here; compose passes them to each service.

# --- Image tags (git SHA from each repo's CI) -------------------------------
# Rollback: set the old SHA here, then `make deploy s=<service>`.
JBH_IAM_TAG=latest
JBH_FINANCE_TAG=latest
JBH_GATEWAY_TAG=latest
JBH_WEB_TAG=latest

# --- Postgres (used by jbh-postgres, jbh-iam, jbh-personal-finance) --------
POSTGRES_USER=jbh_admin
POSTGRES_PASSWORD=change-me

# --- Auth -------------------------------------------------------------------
# HMAC secret. IAM signs tokens with it, the gateway checks them. One value for both.
# Generate: openssl rand -base64 32
JWT_SECRET=change-me
# Google OAuth client IDs, comma separated. Public, not a secret. Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=191326239101-d9dlh362qavadjid6cbi5prqv679npku.apps.googleusercontent.com

# --- Email (jbh-personal-finance notifications) -----------------------------
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=465
GMAIL_USERNAME=change-me@gmail.com
GMAIL_APP_PASSWORD=change-me
GMAIL_FROM=change-me@gmail.com
# Base URL for links in invitation emails.
JBH_FRONTEND_URL=https://jbh.usemagus.cloud

# --- Gateway ----------------------------------------------------------------
# Subnet of the "edge" network (make network). X-Forwarded-For is trusted only from here.
JBH_TRUSTED_PROXIES=10.231.0.0/24

# --- Limits (defaults shown; total about 2.9 GB) ----------------------------
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEM_LIMIT=512M
CONSUL_CPU_LIMIT=0.25
CONSUL_MEM_LIMIT=256M
IAM_CPU_LIMIT=0.75
IAM_MEM_LIMIT=768M
IAM_XMX=384m
FINANCE_CPU_LIMIT=0.75
FINANCE_MEM_LIMIT=768M
FINANCE_XMX=384m
GATEWAY_CPU_LIMIT=0.5
GATEWAY_MEM_LIMIT=512M
GATEWAY_XMX=256m
WEB_CPU_LIMIT=0.1
WEB_MEM_LIMIT=64M

# --- Magus integration (used only by the Makefile) --------------------------
# Magus's Caddy container (docker ps --format '{{.Names}}' | grep caddy).
MAGUS_CADDY_CONTAINER=magus-tesla-api-caddy-1
# Host folder Magus mounts read-only at /etc/caddy/sites.
CADDY_SITES_DIR=/home/magus/caddy-sites
